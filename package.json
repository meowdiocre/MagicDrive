{
  "name": "magicdrive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev --port 8789",
    "dev:web": "vite --port 5173",
    "build": "npm run build:web",
    "build:web": "vite build",
    "brand": "node scripts/build-brand.mjs",
    "spell": "tsx scripts/spell-hash.ts",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx tests/path.test.ts && tsx tests/auth.test.ts && tsx tests/pool.test.ts && tsx tests/registry.test.ts && tsx tests/vault.test.ts && tsx tests/access.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:dry": "npm run build:web && wrangler deploy --dry-run",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "hono": "^4.9.2",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "wrangler": "^4.114.0"
  }
}
